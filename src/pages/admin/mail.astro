---
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import { requireAdmin } from '@/lib/supabaseServerAuth';

const guard = await requireAdmin(Astro);
if (guard) return guard;
---
<AdminLayout title="Correo (TerraMail)" active="mail">
  <p class="mb-4 max-w-2xl text-sm text-slate-500">
    <strong>Características</strong> es JSON: <code class="rounded bg-slate-100 px-1">["Buzón de 10 GB","Soporte 24/7"]</code>.
    Usa las pestañas <strong>Español / English</strong> dentro de cada plan para editar el contenido de cada idioma por separado —
    si dejas un campo en inglés vacío, el sitio en inglés usa automáticamente el texto en español.
  </p>
  <div id="table"></div>
  <script>
    import { mountAdminTable } from '@/lib/adminTable';
    mountAdminTable({
      mount: '#table',
      table: 'mail_plans',
      pk: 'id',
      labelSingular: 'plan de correo',
      titleKey: 'name',
      subtitleKey: 'price',
      pageSize: 15,
      newRowDefaults: {
        name: 'Nuevo plan', users: 1, storage: '10 GB', price: '$0',
        period: '/año', period_en: '', monthly: '', monthly_en: '',
        tagline: '', tagline_en: '', feats: [], feats_en: [],
        href: 'https://my.terranode.net/store/corporate-email', popular: false, sort_order: 99, active: true,
      },
      columns: [
        // — General: igual en ambos idiomas —
        { key: 'id', label: 'ID', type: 'text', width: 'w-24' },
        { key: 'name', label: 'Nombre', type: 'text', width: 'w-28' },
        { key: 'users', label: 'Usuarios', type: 'number', width: 'w-20' },
        { key: 'storage', label: 'Almacén.', type: 'text', width: 'w-20' },
        { key: 'price', label: 'Precio', type: 'text', width: 'w-20' },
        { key: 'href', label: 'Link compra', type: 'text' },
        { key: 'popular', label: 'Popular', type: 'boolean', width: 'w-16' },
        { key: 'sort_order', label: 'Orden', type: 'number', width: 'w-16' },
        { key: 'active', label: 'Activo', type: 'boolean', width: 'w-16' },
        // — Pestaña Español —
        { key: 'period', label: 'Periodo', type: 'text', lang: 'es' },
        { key: 'monthly', label: 'Equiv. mensual', type: 'text', lang: 'es' },
        { key: 'tagline', label: 'Tagline', type: 'text', lang: 'es' },
        { key: 'feats', label: 'Características', type: 'json', lang: 'es' },
        // — Pestaña English —
        { key: 'period_en', label: 'Periodo', type: 'text', placeholder: '/yr', lang: 'en' },
        { key: 'monthly_en', label: 'Equiv. mensual', type: 'text', placeholder: '≈ $2.08/mo', lang: 'en' },
        { key: 'tagline_en', label: 'Tagline', type: 'text', lang: 'en' },
        { key: 'feats_en', label: 'Características', type: 'json', lang: 'en' },
      ],
    });
  </script>
</AdminLayout>
