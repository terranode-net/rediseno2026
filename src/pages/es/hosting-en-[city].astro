---
export const prerender = false;
import BaseLayout from '@/layouts/BaseLayout.astro';
import CityHostingContent from '@/components/CityHostingContent.astro';
import { getCities, getHostingPlans } from '@/lib/db';
import { organizationSchema, breadcrumbSchema, faqSchema, serviceSchema } from '@/lib/schema';
import { SITE_URL } from '@/lib/site';

// La URL real es /es/hosting-en-<slug>/ — Astro permite guiones en el nombre
// del archivo de ruta dinámica, así que el parámetro capturado es solo <slug>.
const { city: citySlugParam } = Astro.params;
const citySlug = String(citySlugParam || '').toLowerCase().trim();

const cities = await getCities();
let city = cities.find((c) => c.slug === citySlug);

// Si el slug no existe en la tabla `cities`, no inventamos una ciudad: 404.
// Esto evita que cualquier URL con /hosting-en-lo-que-sea/ genere una página
// indexable sin datos reales detrás (malo para SEO y para el usuario).
if (!city) {
  return new Response('Ciudad no encontrada', { status: 404 });
}

const hostingPlansRaw = await getHostingPlans();
const plans = hostingPlansRaw.map((p) => ({
  id: p.id,
  name: p.name,
  price: p.price,
  period: p.period,
  tagline: p.tagline,
  popular: p.popular,
  href: p.href,
  feats: p.feats,
}));

const C = city.name;
const country = city.country || 'Ecuador';
const pageUrl = `${SITE_URL}/es/hosting-en-${city.slug}/`;

const title = `Hosting en ${C} | Alojamiento Web Rápido y Seguro · Terranode`;
const description = `Hosting en ${C} con LiteSpeed, cPanel, SSL gratis, backups diarios y soporte 24/7 en español. Migración gratuita. Planes desde $40/año.`;

const faqs = [
  { q: '¿Puedo migrar mi sitio actual a Terranode?', a: `Sí. Ofrecemos migración gratuita desde cualquier proveedor hacia nuestros servidores, incluyendo archivos, base de datos y correos, sin tiempo de inactividad para tus visitantes en ${C}.` },
  { q: '¿El SSL está incluido en todos los planes?', a: 'Sí. Todos los planes incluyen SSL Let\u2019s Encrypt gratuito para tus dominios y subdominios, con renovación automática.' },
  { q: '¿Cuántas cuentas de correo puedo crear?', a: 'Todos los planes incluyen correos ilimitados con tu propio dominio, sin costo adicional.' },
  { q: '¿Qué pasa si supero el límite de almacenamiento?', a: 'Recibirás una notificación antes de alcanzar el límite y podrás actualizar tu plan en cualquier momento desde el panel de cliente.' },
  { q: `¿Tienen soporte técnico para clientes en ${C}?`, a: `Sí. Ofrecemos soporte 24/7 vía chat, WhatsApp y tickets en español, pensado para negocios y profesionales en ${C} y en todo ${country}.` },
  { q: `¿El hosting en ${C} tiene la misma velocidad que en otras ciudades?`, a: `Sí. Nuestra infraestructura no depende de la ubicación física del cliente: todos los sitios alojados en Terranode reciben el mismo nivel de rendimiento sin importar desde dónde se conecten los visitantes.` },
];

const jsonLd = [
  organizationSchema('es'),
  serviceSchema('es', {
    name: `Hosting en ${C}`,
    description: `Servicio de hosting web con LiteSpeed, cPanel, SSL gratis y soporte 24/7 para clientes en ${C}, ${country}.`,
    pageKey: 'hosting',
    serviceType: 'Web Hosting',
    areaServed: [country === 'Ecuador' ? 'EC' : country, C],
  }),
  breadcrumbSchema('es', [
    { name: 'Inicio', key: 'home' },
    { name: 'Hosting', key: 'hosting' },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE_URL}/es/` },
      { '@type': 'ListItem', position: 2, name: 'Hosting', item: `${SITE_URL}/es/hosting/` },
      { '@type': 'ListItem', position: 3, name: `Hosting en ${C}`, item: pageUrl },
    ],
  },
  faqSchema(faqs),
];
---
<BaseLayout
  locale="es"
  pageKey="hosting"
  title={title}
  description={description}
  jsonLd={jsonLd}
  canonicalOverride={{ es: pageUrl, en: `${SITE_URL}/en/hosting-in-${city.slug}/` }}
>
  <CityHostingContent locale="es" city={city} plans={plans} />
</BaseLayout>
