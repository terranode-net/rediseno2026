---
export const prerender = false;
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogPostContent from '@/components/BlogPostContent.astro';
import { getBlogPost, getBlogPosts } from '@/lib/db';
import { organizationSchema, faqSchema } from '@/lib/schema';
import { SITE_URL } from '@/lib/site';

const { slug } = Astro.params;
const post = await getBlogPost('en', slug as string);
if (!post) return new Response('Article not found', { status: 404 });

const allPosts = await getBlogPosts('en');
const related = allPosts
  .filter((p) => p.slug !== post.slug && p.category === post.category)
  .slice(0, 3)
  .map((p) => ({ slug: p.slug, title: p.title, cat: p.category }));

const postUrl = `${SITE_URL}/en/blog/${slug}/`;
const postImage = post.image || `${SITE_URL}/og/og-default.png`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.seo_description || post.excerpt || post.intro,
  image: postImage,
  datePublished: post.published_at,
  dateModified: post.published_at,
  articleSection: post.category,
  author: { '@type': 'Organization', name: post.author, url: SITE_URL },
  publisher: { '@id': `${SITE_URL}/#organization` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  keywords: (post.tags ?? []).join(', '),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/en/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/en/blog/` },
    { '@type': 'ListItem', position: 3, name: post.title, item: postUrl },
  ],
};

const jsonLd = [organizationSchema('en'), articleSchema, breadcrumb];
if (post.faqs && post.faqs.length > 0) jsonLd.push(faqSchema(post.faqs));
---
<BaseLayout
  locale="en"
  pageKey="blog"
  title={post.seo_title || `${post.title} | Terranode Blog`}
  description={post.seo_description || post.intro}
  ogImage={postImage}
  jsonLd={jsonLd}
  canonicalOverride={{ es: `${SITE_URL}/es/blog/${slug}/`, en: postUrl }}
>
  <BlogPostContent locale="en" post={post} related={related} />
</BaseLayout>
